// Prisma Schema per Soldino - Expense Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modello Utente
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relazioni
  accounts      Account[]
  expenses      Expense[]
  categories    Category[]
  contacts      Contact[]
  loans         Loan[]
  auditLogs     AuditLog[]

  @@map("users")
}

// Tipo di account (conto corrente, portafoglio, carta di credito, etc.)
enum AccountType {
  CHECKING      // Conto corrente
  SAVINGS       // Conto risparmio
  CASH          // Portafoglio contanti
  CREDIT_CARD   // Carta di credito
  INVESTMENT    // Investimenti
  OTHER         // Altro
}

// Modello Account (Conti correnti, portafogli, etc.)
model Account {
  id            String      @id @default(uuid())
  name          String
  type          AccountType
  balance       Decimal     @default(0) @db.Decimal(12, 2)
  currency      String      @default("EUR")
  color         String?     // Per UI personalizzazione
  icon          String?     // Icona personalizzata
  description   String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relazioni
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]

  @@map("accounts")
  @@index([userId])
}

// Modello Categoria
model Category {
  id            String      @id @default(uuid())
  name          String
  color         String      @default("#3B82F6")
  icon          String?
  description   String?
  tags          String[]    @default([])
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relazioni
  userId        String?     // null = categoria di sistema
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]

  @@map("categories")
  @@index([userId])
}

// Tipo di spesa
enum ExpenseType {
  EXPENSE       // Spesa
  INCOME        // Entrata
}

// Stato della spesa
enum ExpenseStatus {
  PENDING       // In attesa
  COMPLETED     // Completata
  CANCELLED     // Annullata
}

// Frequenza ricorrenza
enum RecurringFrequency {
  DAILY         // Giornaliera
  WEEKLY        // Settimanale
  BIWEEKLY      // Quindicinale
  MONTHLY       // Mensile
  QUARTERLY     // Trimestrale
  YEARLY        // Annuale
}

// Modello Spesa
model Expense {
  id            String         @id @default(uuid())
  amount        Decimal        @db.Decimal(12, 2)
  type          ExpenseType    @default(EXPENSE)
  description   String
  notes         String?        @db.Text
  date          DateTime       @default(now())
  status        ExpenseStatus  @default(COMPLETED)

  // Metadata AI
  isAiGenerated Boolean        @default(false)
  aiConfidence  Decimal?       @db.Decimal(5, 2) // 0-100
  aiRawData     Json?          // Dati raw dall'AI

  // Geolocalizzazione (opzionale)
  location      String?
  latitude      Decimal?       @db.Decimal(10, 8)
  longitude     Decimal?       @db.Decimal(11, 8)

  // Ricorrenza
  isRecurring   Boolean        @default(false)
  recurringFrequency RecurringFrequency?
  recurringStartDate DateTime?
  recurringEndDate   DateTime?
  recurringLastGenerated DateTime? // Ultima data generazione automatica
  parentRecurringId  String?    // ID della spesa ricorrente originale
  isRecurringGenerated Boolean  @default(false) // True se generata automaticamente

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relazioni
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId     String
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])

  attachments   Attachment[]

  @@map("expenses")
  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
}

// Tipo di allegato
enum AttachmentType {
  IMAGE
  PDF
  DOCUMENT
  OTHER
}

// Modello Allegato
model Attachment {
  id            String         @id @default(uuid())
  filename      String
  originalName  String
  mimeType      String
  size          Int
  type          AttachmentType
  path          String
  thumbnail     String?        // Path thumbnail per immagini
  hash          String         // SHA-256 hash del file

  // Metadata OCR
  ocrText       String?        @db.Text
  ocrData       Json?          // Dati strutturati dall'OCR

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relazioni
  expenseId     String
  expense       Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("attachments")
  @@index([expenseId])
  @@index([hash])
}

// Modello Contatto (Rubrica semplificata)
model Contact {
  id            String    @id @default(uuid())
  name          String
  email         String?
  phone         String?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relazioni
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans         Loan[]

  @@map("contacts")
  @@index([userId])
}

// Tipo di prestito
enum LoanType {
  LENT          // Prestato (siamo creditori)
  BORROWED      // Ricevuto (siamo debitori)
}

// Stato del prestito
enum LoanStatus {
  ACTIVE        // Attivo
  PAID          // Pagato
  CANCELLED     // Annullato
}

// Modello Prestito/Rimborso
model Loan {
  id            String      @id @default(uuid())
  type          LoanType
  amount        Decimal     @db.Decimal(12, 2)
  remainingAmount Decimal   @db.Decimal(12, 2) // Importo rimanente
  description   String
  notes         String?     @db.Text
  loanDate      DateTime    @default(now())
  dueDate       DateTime?   // Data scadenza (opzionale)
  status        LoanStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relazioni
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("loans")
  @@index([userId])
  @@index([contactId])
  @@index([status])
  @@index([type])
}

// Tipo di azione nel log
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  UPLOAD
  DOWNLOAD
  EXPORT
  IMPORT
}

// Modello AuditLog (Registro Eventi)
model AuditLog {
  id            String      @id @default(uuid())
  action        AuditAction
  entity        String      // Nome entità (Expense, Account, Category, etc.)
  entityId      String?     // ID dell'entità modificata
  description   String      // Descrizione operazione
  metadata      Json?       // Dati aggiuntivi
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  // Relazioni
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
